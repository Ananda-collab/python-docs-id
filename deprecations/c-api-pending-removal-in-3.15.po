":c:var:`Py_DebugFlag`: Use :c:member:`PyConfig.parser_debug` or :c:func:"
"`PyConfig_Get(\"parser_debug\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_DebugFlag`: Gunakan :c:member:`PyConfig.parser_debug` atau :c:func:"
"`PyConfig_Get(\”parser_debug\“) <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_VerboseFlag`: Use :c:member:`PyConfig.verbose` or :c:func:"
"`PyConfig_Get(\"verbose\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_VerboseFlag`: Gunakan :c:member:`PyConfig.verbose` atau :c:func:"
"`PyConfig_Get(\"verbose\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_QuietFlag`: Use :c:member:`PyConfig.quiet` or :c:func:"
"`PyConfig_Get(\"quiet\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_QuietFlag`: Gunakan :c:member:`PyConfig.quiet` atau :c:func:"
"`PyConfig_Get(\"quiet\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_InteractiveFlag`: Use :c:member:`PyConfig.interactive` or :c:func:"
"`PyConfig_Get(\"interactive\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_InteractiveFlag`: Gunakan :c:member:`PyConfig.interactive` atau :c:func:"
"`PyConfig_Get(\"interactive\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_InspectFlag`: Use :c:member:`PyConfig.inspect` or :c:func:"
"`PyConfig_Get(\"inspect\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_InspectFlag`: Gunakan :c:member:`PyConfig.inspect` atau :c:func:"
"`PyConfig_Get(\"inspect\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_OptimizeFlag`: Use :c:member:`PyConfig.optimization_level` or :c:"
"func:`PyConfig_Get(\"optimization_level\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_OptimizeFlag`: Gunakan :c:member:`PyConfig.optimization_level` atau :c:"
"func:`PyConfig_Get(\"optimization_level\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_NoSiteFlag`: Use :c:member:`PyConfig.site_import` or :c:func:"
"`PyConfig_Get(\"site_import\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_NoSiteFlag`: Gunakan :c:member:`PyConfig.site_import` atau :c:func:"
"`PyConfig_Get(\"site_import\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_BytesWarningFlag`: Use :c:member:`PyConfig.bytes_warning` or :c:"
"func:`PyConfig_Get(\"bytes_warning\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_BytesWarningFlag`: Gunakan :c:member:`PyConfig.bytes_warning` atau :c:"
"func:`PyConfig_Get(\"bytes_warning\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_FrozenFlag`: Use :c:member:`PyConfig.pathconfig_warnings` or :c:"
"func:`PyConfig_Get(\"pathconfig_warnings\") <PyConfig_Get>` instead."
msgstr ""
“:c:var:`Py_FrozenFlag`: Gunakan :c:member:`PyConfig.pathconfig_warnings` atau :c:”
“func:`PyConfig_Get(\”pathconfig_warnings\“) <PyConfig_Get>` sebagai gantinya.”

msgid ""
":c:var:`Py_IgnoreEnvironmentFlag`: Use :c:member:`PyConfig.use_environment` "
"or :c:func:`PyConfig_Get(\"use_environment\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_IgnoreEnvironmentFlag`: Gunakan :c:member:`PyConfig.use_environment` "
"atau :c:func:`PyConfig_Get(\"use_environment\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_DontWriteBytecodeFlag`: Use :c:member:`PyConfig.write_bytecode` "
"or :c:func:`PyConfig_Get(\"write_bytecode\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_DontWriteBytecodeFlag`: Gunakan :c:member:`PyConfig.write_bytecode` "
"atau :c:func:`PyConfig_Get(\"write_bytecode\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_NoUserSiteDirectory`: Use :c:member:`PyConfig."
"user_site_directory` or :c:func:`PyConfig_Get(\"user_site_directory\") "
"<PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_NoUserSiteDirectory`: Gunakan :c:member:`PyConfig."
"user_site_directory` atau :c:func:`PyConfig_Get(\"user_site_directory\") "
"<PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_UnbufferedStdioFlag`: Use :c:member:`PyConfig.buffered_stdio` or :"
"c:func:`PyConfig_Get(\"buffered_stdio\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_UnbufferedStdioFlag`: Gunakan :c:member:`PyConfig.buffered_stdio` atau :"
"c:func:`PyConfig_Get(\"buffered_stdio\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_HashRandomizationFlag`: Use :c:member:`PyConfig.use_hash_seed` "
"and :c:member:`PyConfig.hash_seed` or :c:func:`PyConfig_Get(\"hash_seed\") "
"<PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_HashRandomizationFlag`: Gunakan :c:member:`PyConfig.use_hash_seed` "
"dan :c:member:`PyConfig.hash_seed` atau :c:func:`PyConfig_Get(\"hash_seed\“) "
"<PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_IsolatedFlag`: Use :c:member:`PyConfig.isolated` or :c:func:"
"`PyConfig_Get(\"isolated\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_IsolatedFlag`: Gunakan :c:member:`PyConfig.isolated` atau :c:func:"
"`PyConfig_Get(\"isolated\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_LegacyWindowsFSEncodingFlag`: Use :c:member:`PyPreConfig."
"legacy_windows_fs_encoding` or :c:func:"
"`PyConfig_Get(\"legacy_windows_fs_encoding\") <PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_LegacyWindowsFSEncodingFlag`: Gunakan :c:member:`PyPreConfig."
"legacy_windows_fs_encoding` atau :c:func:"
"`PyConfig_Get(\"legacy_windows_fs_encoding\") <PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`Py_LegacyWindowsStdioFlag`: Use :c:member:`PyConfig."
"legacy_windows_stdio` or :c:func:`PyConfig_Get(\"legacy_windows_stdio\") "
"<PyConfig_Get>` instead."
msgstr ""
":c:var:`Py_LegacyWindowsStdioFlag`: Gunakan :c:member:`PyConfig."
"legacy_windows_stdio` atau :c:func:`PyConfig_Get(\”legacy_windows_stdio\“) "
"<PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`!Py_FileSystemDefaultEncoding`, :c:var:`!"
"Py_HasFileSystemDefaultEncoding`: Use :c:member:`PyConfig."
"filesystem_encoding` or :c:func:`PyConfig_Get(\"filesystem_encoding\") "
"<PyConfig_Get>` instead."
msgstr ""
":c:var:`!Py_FileSystemDefaultEncoding`, :c:var:`!"
"Py_HasFileSystemDefaultEncoding`: Gunakan :c:member:`PyConfig."
"filesystem_encoding` atau :c:func:`PyConfig_Get(\”filesystem_encoding\") "
"<PyConfig_Get>` sebagai gantinya.”

msgid ""
":c:var:`!Py_FileSystemDefaultEncodeErrors`: Use :c:member:`PyConfig."
"filesystem_errors` or :c:func:`PyConfig_Get(\"filesystem_errors\") "
"<PyConfig_Get>` instead."
msgstr ""
":c:var:`!Py_FileSystemDefaultEncodeErrors`: Gunakan :c:member:`PyConfig."
"filesystem_errors` atau :c:func:`PyConfig_Get(\”filesystem_errors\") "
"<PyConfig_Get>` sebagai gantinya."

msgid ""
":c:var:`!Py_UTF8Mode`: Use :c:member:`PyPreConfig.utf8_mode` or :c:func:"
"`PyConfig_Get(\"utf8_mode\") <PyConfig_Get>` instead. (see :c:func:"
"`Py_PreInitialize`)"
msgstr ""
":c:var:`!Py_UTF8Mode`: Gunakan :c:member:`PyPreConfig.utf8_mode` atau :c:func:"
"`PyConfig_Get(\"utf8_mode\") <PyConfig_Get>` sebagai gantinya. (lihat :c:func:"
"`Py_PreInitialize`)"

msgid ""
"The :c:func:`Py_InitializeFromConfig` API should be used with :c:type:"
"`PyConfig` to set these options. Or :c:func:`PyConfig_Get` can be used to "
"get these options at runtime."
msgstr ""
"Antarmuka API :c:func:`Py_InitializeFromConfig` harus digunakan bersama dengan :c:type:"
"`PyConfig` untuk mengatur opsi-opsi ini. Atau :c:func:`PyConfig_Get` dapat digunakan untuk "
"mendapatkan opsi-opsi ini pada saat runtime."
